 "subs": [
  {
   "id": "l01_0",
   "line": "l01",
   "text": "In 1925, a man sold the Eiffel Tower.",
   "t0": 0.35,
   "t1": 4.11
  },
  {
   "id": "l01_1",
   "line": "l01",
   "text": "Then he came back, and tried to sell it again.",
   "t0": 4.53,
   "t1": 7.45
  },
  {
   "id": "l02_2",
   "line": "l02",
   "text": "His name was Victor Lustig.",
   "t0": 7.95,
   "t1": 10.09
  },
  {
   "id": "l02_3",
   "line": "l02",
   "text": "And he never owned a single bolt of it.",
   "t0": 10.13,
   "t1": 12.93
  },
  {
   "id": "l03_4",
   "line": "l03",
   "text": "As the story goes, it began with a newspaper.",
   "t0": 13.35,
   "t1": 16.41
  },
  {
   "id": "l03_5",
   "line": "l03",
   "text": "The tower was rusting, and repairs were expensive.",
   "t0": 16.89,
   "t1": 20.05
  },
  {
   "id": "l04_6",
   "line": "l04",
   "text": "Lustig saw an opportunity.",
   "t0": 20.85,
   "t1": 22.13
  },
  {
   "id": "l04_7",
   "line": "l04",
   "text": "He printed official-looking letters, and invited scrap dealers to a secret meeting, in a grand Paris hotel.",
   "t0": 22.17,
   "t1": 29.57
  },
  {
   "id": "l05_8",
   "line": "l05",
   "text": "Posing as a government official, he said the city would sell the tower for scrap.",
   "t0": 31.15,
   "t1": 35.43
  },
  {
   "id": "l05_9",
   "line": "l05",
   "text": "7,000 tons of iron. Top secret.",
   "t0": 35.47,
   "t1": 38.63
  },
  {
   "id": "l06_10",
   "line": "l06",
   "text": "One dealer, Andr\u00e9 Poisson, wanted it badly.",
   "t0": 40.45,
   "t1": 42.99
  },
  {
   "id": "l06_11",
   "line": "l06",
   "text": "He was new in Paris, and wanted to be someone.",
   "t0": 43.03,
   "t1": 46.79
  },
  {
   "id": "l07_12",
   "line": "l07",
   "text": "But he had doubts. Why so secret? Why so fast?",
   "t0": 47.65,
   "t1": 51.17
  },
  {
   "id": "l08_13",
   "line": "l08",
   "text": "So he confessed. Officials were badly paid.",
   "t0": 52.25,
   "t1": 55.53
  },
  {
   "id": "l08_14",
   "line": "l08",
   "text": "He wanted a bribe.",
   "t0": 55.57,
   "t1": 57.37
  },
  {
   "id": "l09_15",
   "line": "l09",
   "text": "And that convinced him.",
   "t0": 57.55,
   "t1": 58.71
  },
  {
   "id": "l09_16",
   "line": "l09",
   "text": "Only a real official would ask for a bribe.",
   "t0": 58.75,
   "t1": 62.07
  },
  {
   "id": "l10_17",
   "line": "l10",
   "text": "Poisson paid for the tower, and the bribe.",
   "t0": 62.75,
   "t1": 65.69
  },
  {
   "id": "l10_18",
   "line": "l10",
   "text": "Lustig took the money, and left the country.",
   "t0": 66.01,
   "t1": 68.81
  },
  {
   "id": "l11_19",
   "line": "l11",
   "text": "And Poisson? He was too embarrassed to tell the police.",
   "t0": 69.35,
   "t1": 72.69
  },
  {
   "id": "l12_20",
   "line": "l12",
   "text": "So Lustig came back, and tried to sell it again.",
   "t0": 74.05,
   "t1": 77.13
  },
  {
   "id": "l12_21",
   "line": "l12",
   "text": "This time, someone called the police. He slipped away.",
   "t0": 77.43,
   "t1": 81.13
  },
  {
   "id": "l13_22",
   "line": "l13",
   "text": "Years later, he was caught in America, for printing fake money.",
   "t0": 81.75,
   "t1": 85.93
  },
  {
   "id": "l14_23",
   "line": "l14",
   "text": "The tower is still standing. Still not for sale.",
   "t0": 86.65,
   "t1": 90.09
  }
 ],
