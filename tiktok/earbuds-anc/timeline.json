 "subs": [
  {
   "id": "l01_0",
   "line": "l01",
   "text": "7:42 PM. The loudest train in the city.",
   "t0": 0.45,
   "t1": 4.59
  },
  {
   "id": "l02_1",
   "line": "l02",
   "text": "Around 90 decibels of steel on steel.",
   "t0": 5.05,
   "t1": 7.87
  },
  {
   "id": "l02_2",
   "line": "l02",
   "text": "Then she presses one button.",
   "t0": 8.11,
   "t1": 10.15
  },
  {
   "id": "l03_3",
   "line": "l03",
   "text": "And the train disappears. But nothing blocked it.",
   "t0": 11.45,
   "t1": 14.45
  },
  {
   "id": "l03_4",
   "line": "l03",
   "text": "Her earbuds added more sound.",
   "t0": 14.49,
   "t1": 16.61
  },
  {
   "id": "l04_5",
   "line": "l04",
   "text": "Here's how.",
   "t0": 17.25,
   "t1": 19.05
  },
  {
   "id": "l05_6",
   "line": "l05",
   "text": "On the outside, a tiny microphone hears the train, thousands of times every second.",
   "t0": 19.85,
   "t1": 26.11
  },
  {
   "id": "l06_7",
   "line": "l06",
   "text": "A chip takes that sound wave, and flips it upside down.",
   "t0": 26.65,
   "t1": 30.71
  },
  {
   "id": "l07_8",
   "line": "l07",
   "text": "Where the train pushes the air, the speaker pulls.",
   "t0": 31.25,
   "t1": 33.97
  },
  {
   "id": "l07_9",
   "line": "l07",
   "text": "Where it pulls, the speaker pushes.",
   "t0": 34.03,
   "t1": 36.47
  },
  {
   "id": "l08_10",
   "line": "l08",
   "text": "Two waves, exactly opposite. Added together, they cancel out.",
   "t0": 37.25,
   "t1": 41.73
  },
  {
   "id": "l09_11",
   "line": "l09",
   "text": "A second microphone, inside, listens to what's left, and fixes the mistakes.",
   "t0": 43.05,
   "t1": 48.19
  },
  {
   "id": "l10_12",
   "line": "l10",
   "text": "It works best on steady rumble, like engines and trains.",
   "t0": 49.05,
   "t1": 52.55
  },
  {
   "id": "l10_13",
   "line": "l10",
   "text": "Sudden sounds are harder, so the soft ear tip blocks those.",
   "t0": 53.05,
   "t1": 57.39
  },
  {
   "id": "l11_14",
   "line": "l11",
   "text": "So when she hears nothing, her ears are full of sound.",
   "t0": 58.45,
   "t1": 62.07
  },
  {
   "id": "l11_15",
   "line": "l11",
   "text": "Just the exact opposite of the train.",
   "t0": 62.45,
   "t1": 64.91
  },
  {
   "id": "l12_16",
   "line": "l12",
   "text": "Next stop: hers.",
   "t0": 66.45,
   "t1": 68.25
  }
 ],
